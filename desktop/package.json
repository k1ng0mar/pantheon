{
  "name": "pantheon-desktop",
  "private": true,
  "version": "1.2.0",
  "description": "Pantheon Desktop - a native workspace for the Pantheon agent runtime.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/k1ng0mar/pantheon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1ng0mar/pantheon.git"
  },
  "bugs": {
    "url": "https://github.com/k1ng0mar/pantheon/issues"
  },
  "type": "module",
  "scripts": {
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "site:preview": "npm --prefix website run preview",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "package:fast": "tauri build -- --profile fast-release",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "release:version": "node scripts/release/set-version.mjs",
    "release:build": "node scripts/release/build.mjs",
    "test:release": "node --test scripts/release/*.test.mjs packages/npx/*.test.mjs",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.7.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.5.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "material-icon-theme": "5.40.0",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
